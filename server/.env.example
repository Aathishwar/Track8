# Copy to .env for local development. On Render these are set in the
# Environment tab instead, and no .env file exists there.
#
# .env is gitignored. Never commit real values - the repository is public, and
# the VAPID private key alone lets anyone push notifications to every phone
# that has installed this app.

# --- Push reminders -------------------------------------------------------
# Generate once with: npm run keys
# Changing these invalidates every phone's subscription until it reopens the app.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Sync -----------------------------------------------------------------
# Neon: the POOLED connection string, ending in ?sslmode=require
# Leave empty to run without sync; the app still works, local-only.
DATABASE_URL=

# --- Sign-in email --------------------------------------------------------
# Brevo HTTP API, not SMTP: Render blocks outbound ports 25, 465 and 587.
# BREVO_API_KEY   -> SMTP & API -> API Keys
# MAIL_FROM_EMAIL -> an address verified under Senders
# Leave BREVO_API_KEY empty locally and the sign-in code is printed to the
# server console instead of emailed, which is enough to test the flow.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Track8

# --- Funny reminder lines (optional) --------------------------------------
# Server-sent reminders are plain English unless PUSH_QUIPS=1. Leave it off
# unless every phone on this server wants Tanglish: the server cannot tell
# which of them turned on the in-app easter egg.
PUSH_QUIPS=
# With a key set as well, the server asks an NVIDIA NIM model for a fresh batch
# of lines every few hours and mixes them into the built-in pack. The model is
# never called while sending a reminder, so an outage or a missing key changes
# nothing about delivery.
# Key: https://build.nvidia.com  ->  any chat model  ->  Get API Key
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct

# Local port. Render sets this itself.
PORT=3000
